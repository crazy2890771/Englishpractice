# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://efl:efl@localhost:5432/efl?schema=public"

# ── Sessions ────────────────────────────────────────────────────────────────
# Long random string (e.g. `openssl rand -hex 32`). Used to hash session tokens.
SESSION_SECRET="change-me-to-a-long-random-string"

# ── AI providers (server-side only — never prefix these with NEXT_PUBLIC_) ──
# Leave every key empty to run in DEMO MODE (rule-based feedback, browser speech).
# LLM provider: "anthropic" | "openai" | "mock". "auto" picks the first configured key.
AI_LLM_PROVIDER="auto"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Speech-to-text: "openai" | "browser". "auto" = openai if OPENAI_API_KEY is set.
AI_STT_PROVIDER="auto"
OPENAI_STT_MODEL="whisper-1"

# Text-to-speech: "openai" | "browser". "auto" = openai if OPENAI_API_KEY is set.
AI_TTS_PROVIDER="auto"
OPENAI_TTS_MODEL="tts-1"

# ── Limits & cost controls ─────────────────────────────────────────────────
AI_REQUEST_TIMEOUT_MS="30000"
# Hard caps applied to every user (users can set lower caps in Settings).
AI_MAX_DAILY_REQUESTS="300"
AI_MAX_MONTHLY_COST_CENTS="1000"
# Per-user, per-minute burst limit for AI endpoints.
AI_RATE_LIMIT_PER_MINUTE="20"
# Demo accounts a single IP may create per minute.
DEMO_RATE_LIMIT_PER_MINUTE="5"
# Max upload size for audio (bytes).
MAX_AUDIO_BYTES="10485760"
