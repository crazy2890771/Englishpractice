# ── Supabase ────────────────────────────────────────────────────────────────
# Local: values printed by `npx supabase start`. Cloud: Project Settings → API / Database.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon / publishable key>"
# Direct Postgres connection used by the server (RLS is enforced per request).
# Cloud on Vercel: use the "Transaction pooler" URL (port 6543).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ── AI providers (server-side only — never NEXT_PUBLIC_) ───────────────────
# Leave empty for DEMO MODE: deterministic exercises work fully; open answers get
# clearly-labelled rule-based demo feedback; speech uses the browser.
AI_PROVIDER="auto"                 # auto | anthropic | openai | none
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_STT_MODEL="whisper-1"       # server speech-to-text (en + zh)
OPENAI_TTS_MODEL="tts-1"           # server text-to-speech (en + zh)

# ── Limits ─────────────────────────────────────────────────────────────────
AI_TIMEOUT_MS="30000"
AI_MAX_DAILY_REQUESTS="300"
AI_RATE_LIMIT_PER_MINUTE="20"
